[calendars]
[[default]]
path = ~/.local/share/khal/calendars/default/
type = discover
color = dark red

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M
firstweekday = 0

[default]
default_calendar = default
highlight_days = True
show_all_days = False
