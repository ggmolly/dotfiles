[global]
    font = BerkeleyMono Nerd Font 10
    
    # Allow a small markup
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    
    # Size and Positioning
    width = 320
    height = 300
    offset = 12x45
    origin = top-right
    
    # Behavior
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    shrink = no
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    history_length = 20
    show_indicators = yes
    
    # Spacing and Padding
    line_height = 4
    separator_height = 2
    padding = 16
    horizontal_padding = 16
    
    # Aesthetics (Matching i3 and Rofi: Sharp corners, pink accent)
    separator_color = frame
    frame_width = 2
    corner_radius = 0
    
    # Icons
    icon_position = left
    max_icon_size = 48
    
    # Mouse Interactions
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#111319"
    foreground = "#8B93A6"
    frame_color = "#1A1F2B"
    timeout = 5

[urgency_normal]
    background = "#111319"
    foreground = "#E8ECF2"
    frame_color = "#E35D8F"
    timeout = 10

[urgency_critical]
    background = "#FF5555"
    foreground = "#111319"
    frame_color = "#111319"
    timeout = 0
    
[discord]
    appname = Discord
    frame_color = "#3A445E"

[spotify]
    appname = Spotify
    frame_color = "#C94F7C"
    icon_position = off
