{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/main/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "magenta"
    }
  },
  "display": {
    "separator": "   "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "magenta"
      }
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "󰏖 ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
